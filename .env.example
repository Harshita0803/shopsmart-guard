# Copy this file to .env (same folder) and fill it in.
# .env is in .gitignore, so it is NEVER pushed to GitHub.

# Your OpenAI key (platform.openai.com > API keys). Keep it private.
OPENAI_API_KEY=sk-...

# The model the chatbot uses. Pick a cheap "mini" model your account lists.
OPENAI_MODEL=gpt-4o-mini

# Optional: a different model for the LLM judge (defaults to OPENAI_MODEL).
# JUDGE_MODEL=gpt-4o-mini

# Optional: a passcode visitors must type before chatting (protects your budget).
# DEMO_PASSCODE=group5demo

# Optional: messages per minute per visitor (default 20).
# RATE_LIMIT_PER_MIN=20

# Set to 1 to use the fake offline model (free, for testing the code only).
# LLM_MOCK=1
